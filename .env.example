# docker compose 使用的环境变量。复制为 .env 后按实际情况修改。

# Postgres 密码，必填。
POSTGRES_PASSWORD=

# 渠道密钥加密主密钥，必填，32 字节。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1

# 对外端口
WEB_PORT=3000

# 反向代理已配置 HTTPS 时保持 true；纯 HTTP 调试时改成 false，否则浏览器不会回传会话 Cookie。
SESSION_COOKIE_SECURE=true
# 生产环境跨子域共享登录态时设置，例如 .jingtiang.com
SESSION_COOKIE_DOMAIN=
# 可选。同源反代通常留空；如需跨域再填写 https://example.com,https://www.example.com
CORS_ORIGINS=

# 生成任务并发与单用户同时进行中的任务上限
GENERATION_WORKER_CONCURRENCY=4
GENERATION_MAX_ACTIVE_PER_USER=3

LOG_LEVEL=info
