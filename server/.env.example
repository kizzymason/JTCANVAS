# 复制为 .env 后按实际环境修改。
NODE_ENV=development
PORT=4000
API_PREFIX=api
LOG_LEVEL=debug

# PostgreSQL 连接串，必填。
DATABASE_URL=postgres://infinite:infinite@127.0.0.1:5432/infinite_canvas
DATABASE_POOL_MAX=10

# Redis，用于会话、队列、缓存、限流与 SSE 广播。
REDIS_URL=redis://127.0.0.1:6379

# 会话
SESSION_COOKIE_NAME=ic_session
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false

# 渠道密钥加密主密钥，必填，必须是 32 字节（64 位 hex 或 44 位 base64）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1
# 轮换旧密钥时保留解密能力：APP_ENCRYPTION_KEY_OLD_k1=<旧密钥>

# 本机磁盘存储根目录，需与 nginx 的 internal location 指向同一路径。
STORAGE_LOCAL_ROOT=/data/storage
STORAGE_INTERNAL_PREFIX=/internal-files
STORAGE_SIGNED_URL_TTL_SECONDS=3600
# 生产环境（有 nginx）默认开启：API 只鉴权，由 nginx 通过 X-Accel-Redirect 发文件。
# 本地 `npm run dev` 没有 nginx，必须保持关闭，否则 /api/files 会返回 0 字节空响应。
# STORAGE_X_ACCEL_REDIRECT=false

# 生成任务边界值
GENERATION_WORKER_CONCURRENCY=4
GENERATION_MAX_ACTIVE_PER_USER=3
GENERATION_IMAGE_TIMEOUT_MS=300000
GENERATION_VIDEO_TIMEOUT_MS=1800000
GENERATION_POLL_INTERVAL_MS=2500
GENERATION_ATTEMPTS=3

# 管理员自定义脚本沙箱
SCRIPT_MEMORY_LIMIT_MB=128
SCRIPT_TIMEOUT_MS=60000
# 除渠道自身域名外额外允许出网的域名，逗号分隔
SCRIPT_ALLOWED_HOSTS=

# WhatsToken 正价渠道 API Key。启动时若渠道尚无密钥则加密写入；留空则只预置渠道和模型，密钥到管理后台粘贴。
WHATSTOKEN_API_KEY=

# Z-Pay / 易支付。仅在 payment_channels 为空时预置一条渠道；密钥加密入库，不要提交真实值。
# 文档：https://z-pay.cn/doc.html  网关默认 https://zpayz.cn
ZPAY_PID=
ZPAY_KEY=
ZPAY_GATEWAY=https://zpayz.cn

# 生产环境填写对外可访问的 https 源站，例如 https://jingtiang.com。
# PiAPI 图生图在临时图床套餐不够时，会用带短时签名的 /api/files 地址把参考图透传给上游。
APP_PUBLIC_URL=

# 仅当前端与后端不同源时才需要填写，逗号分隔
CORS_ORIGINS=
