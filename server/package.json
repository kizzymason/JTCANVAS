{
    "name": "@basketikun/infinite-canvas-server",
    "version": "0.1.0",
    "description": "Infinite Canvas commercial backend: auth, wallet, billing and AI generation proxy",
    "private": true,
    "license": "MIT",
    "type": "commonjs",
    "main": "dist/main.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "nest start --watch",
        "dev:worker": "nest start --watch --entryFile worker",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "start:worker": "node dist/worker.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "seed:admin": "tsx src/scripts/create-admin.ts",
        "seed:piapi-pool": "tsx src/scripts/import-piapi-csv.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1121.0",
        "@aws-sdk/s3-request-presigner": "^3.1121.0",
        "@fastify/cookie": "^11.1.2",
        "@fastify/multipart": "^10.1.1",
        "@fastify/static": "^10.1.3",
        "@nestjs/bullmq": "^12.0.0",
        "@nestjs/common": "^11.2.3",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^11.2.3",
        "@nestjs/platform-fastify": "^11.2.3",
        "@nestjs/schedule": "^12.0.1",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@node-rs/argon2": "^2.2.0",
        "axios": "^1.20.0",
        "bullmq": "^6.3.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "decimal.js": "^10.6.0",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^6.0.0",
        "isolated-vm": "^7.0.1",
        "nestjs-pino": "^4.6.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "postgres": "^3.4.9",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/testing": "^11.2.3",
        "@types/node": "^26.4.0",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "tsx": "^4.23.13",
        "typescript": "^5",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "@scarf/scarf": false,
        "msgpackr-extract": false,
        "isolated-vm@7.0.1": true
    }
}
